# Ophthalmology Radar — Intelligence Layer
# Copy to .env and fill with real values. NEVER commit the real .env.

# --- Supabase (public, shipped to the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-only) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key — server only, full DB access. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Gateway (server-only) ---
LOVABLE_API_KEY=
# Chat model used by the clinical/case/tutor AI. Defaults to openai/gpt-4.1-mini
# (matches Settings → Proveedor de IA). The embedding model is fixed at
# openai/text-embedding-3-small (vector(1536)) and is NOT configurable.
AI_CHAT_MODEL=openai/gpt-4.1-mini

# --- Reindex webhook (server-only) ---
# Strong random secret used by pg_cron to call /api/public/hooks/reindex-evidence
REINDEX_WEBHOOK_SECRET=

# --- AI usage quota (server-only, optional) ---
# Max AI queries per user per day. Fallback only: the admin Settings → Límites
# de uso value (or_ai_settings.daily_query_limit) takes precedence. Set <= 0 to
# disable. Default 100.
AI_DAILY_QUERY_LIMIT=100

# --- Radar Hunt (públicas, van al navegador) ---
# Película Eye Universe (máster v4) en HLS (.m3u8) o MP4 servida por CDN. Sin ella, la
# película usa los insertos de /public/eye (S02Z y S04C) y el resto de capítulos se ven en 3D.
VITE_EYE_VIDEO_URL=
# Fuerza el modo demostración aunque Supabase esté configurado (true/false).
# Ojo: mientras RH_FORCE_DEMO = true en src/lib/radar-hunt/deploy.ts, Radar Hunt va en demo
# igualmente (despliegue en Lovable antes de aplicar las migraciones de Radar Hunt).
VITE_RH_DEMO=false
